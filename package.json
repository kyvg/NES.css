{
  "name": "nes.css",
  "description": "NES.css is NES-style CSS Framework.",
  "scripts": {
    "lint": "run-p lint:*",
    "lint:es": "eslint .",
    "lint:css": "stylelint **/*.css",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:docgen": "tsx ./scripts/docgen/index.ts",
    "build:css": "vite build",
    "build": "npm run build:docgen && npm run build:css"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nostalgic-css/NES.css.git"
  },
  "keywords": [
    "css",
    "scss",
    "nes",
    "framework"
  ],
  "author": "BcRikko (https://github.com/Bcrikko)",
  "license": "MIT",
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-interactions": "^8.6.12",
    "@storybook/addon-links": "^8.6.12",
    "@storybook/addon-mdx-gfm": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/html": "^8.6.12",
    "@storybook/html-vite": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@types/postcss-import": "^14.0.0",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "eslint": "^8.37.0",
    "glob": "^8.1.0",
    "postcss": "^8.4.21",
    "postcss-import": "^15.1.0",
    "storybook": "^8.6.12",
    "stylelint": "^15.3.0",
    "stylelint-config-recess-order": "^4.0.0",
    "stylelint-config-recommended": "^11.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.0.3"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
